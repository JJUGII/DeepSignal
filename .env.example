# ════════════════════════════════════════════════════════════════
#  DeepSignal 환경 변수 템플릿 (.env.example)
# ════════════════════════════════════════════════════════════════
# 사용법: 이 파일을 복사해 프로젝트 루트에 .env 로 저장한 뒤 값을 채웁니다.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# ⚠️ 주의사항
#  · 실제 API 키·토큰·계좌번호는 .env 에만 두고 git 커밋·채팅 공유 금지.
#  · "KEY=값 # 주석" 처럼 같은 줄에 주석 쓰면 값에 섞입니다. 주석은 별도 줄에만.
#  · 처음엔 전부 페이퍼/드라이런(true)으로 시작하고, 검증 후 실거래로 바꾸세요.
# ════════════════════════════════════════════════════════════════


# ── AI / LLM (선택) ──────────────────────────────────────────
# OpenAI 키: 뉴스·공시 감성분석, 호재/악재 게이트에 사용 (없으면 LLM 기능 OFF)
OPENAI_API_KEY=
DEEPSIGNAL_LLM_MODEL=gpt-4o-mini
CRYPTO_LLM_NEWS_ENABLED=false   # 코인 뉴스 LLM 감성분석 on/off
NEWS_LLM_ENABLED=false          # 주식 뉴스 LLM 분석 on/off
# DART(전자공시) 키: 국내주식 공시 촉매 분석 (https://opendart.fss.or.kr)
DART_API_KEY=


# ── Upbit (코인) ─────────────────────────────────────────────
# 발급: https://upbit.com/mypage/open_api_management
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_DRY_RUN=true              # true=주문 안 함(로그만), false=실거래


# ── Bithumb (코인, 선택) ─────────────────────────────────────
# 발급: https://www.bithumb.com/react/ucenter/open-api (Open API 2.x)
BITHUMB_API_KEY=
BITHUMB_SECRET_KEY=
BITHUMB_DRY_RUN=true            # true=주문 안 함, false=실주문


# ── 코인 공통 ────────────────────────────────────────────────
CRYPTO_PAPER_MODE=true          # true=모든 코인 주문 차단(안전). 실거래 시 false
CRYPTO_BROKER=upbit             # 활성 거래소 (upbit | bithumb) — 거래·조회 기준
CRYPTO_AUTO_EXECUTE_WITHOUT_APPROVAL=false  # true=승인없이 자동매매(위험)


# ── 공격성 다이얼 (1~10) ─────────────────────────────────────
# 1~8=안전(검증 엣지만 거래), 9~10=공격/도박(미검증 전략·풀투입·청산가능).
# 이 한 값이 손절폭·매수빈도·한도·전략 게이트 ~30개를 일괄 조절합니다.
DEEPSIGNAL_AGGRESSION=5


# ── 상장 감시 (조회·알림 전용, 자동매수 없음) ────────────────
LISTING_SCAN_ENABLED=true
LISTING_SCAN_INTERVAL_MIN=10           # 스캔 주기(분)
LISTING_MIN_ACC_TRADE_24H=100000000    # 최소 24h 거래대금(원) 필터
LISTING_VOL_RATIO_ALERT=2.5            # 거래량 급증 배수 기준
LISTING_ANOMALY_SCORE_ALERT=60         # 알림 점수 문턱(낮출수록 알림↑)
LISTING_TELEGRAM_ALERT=false           # true=상장감시 텔레그램 알림 ON
LISTING_MAX_DEEP_SCAN=60               # 정밀 스캔 최대 종목 수


# ── 코인 매수 모멘텀 밴드 (실측 승률 기반) ───────────────────
# 일간변동(전일종가 대비) 이 구간에서 매수 가점 정점, 과대상승은 감점.
CRYPTO_MOMENTUM_SWEET_MIN_PCT=1.0
CRYPTO_MOMENTUM_SWEET_MAX_PCT=5.0


# ── KIS (국내·해외 주식, 선택) ───────────────────────────────
# 발급: 한국투자증권 KIS Developers (https://apiportal.koreainvestment.com)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=                 # 계좌번호 앞 8자리
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_HTS_ID=
KIS_ENV=paper                   # paper=모의, live=실계좌
# 국내주식 무승인 자동매매 (장중 체결 시에만 알림)
KIS_STOCK_AUTO_EXECUTE_WITHOUT_APPROVAL=false
KIS_STOCK_MAX_ORDERS_PER_DAY=3
KIS_STOCK_MAX_SINGLE_ORDER_VALUE=300000   # 단일 주문 상한(원)
KIS_STOCK_MAX_TOTAL_ORDER_VALUE=300000    # 일일 총 주문 상한(원)
# 국내주식 자동 손절/익절
KIS_AUTO_SELL_TAKE_PROFIT=true
KIS_AUTO_SELL_STOP_LOSS=true


# ── 해외주식(미국장) 자동매매 (선택) ─────────────────────────
OVERSEAS_AUTO_EXECUTE_WITHOUT_APPROVAL=false
OVERSEAS_CAPITAL_USD=1000               # 해외 매수 총 자본(USD)
OVERSEAS_MAX_SINGLE_ORDER_USD=300       # 단일 주문 상한(USD)
OVERSEAS_MAX_ORDERS_PER_RUN=3
OVERSEAS_RUNNER_INTERVAL_MIN=5
# 해외 손실방지 (트레일링·당일 연속손절 차단)
OVERSEAS_TRAILING_STOP_PCT=5.0
OVERSEAS_MAX_STOP_LOSS_PER_DAY=1


# ── 추세추종 / 레버리지 ETF (선택, 검증된 엣지) ──────────────
REGIME_TREND_LIVE=false                 # S&P 추세추종 ETF 실거래
REGIME_TREND_ETF=360750                 # 예: TIGER 미국S&P500
REGIME_TREND_ALLOC_KRW=0                # 배분 한도(원), 0=비활성
LEVERAGE_TREND_LIVE=false
REGIME_LEVERAGE_ENABLED=false
REGIME_MAX_LEVERAGE=2


# ── 무인 자동실행 시간창 (20:00~09:00 등) ────────────────────
DEEPSIGNAL_INACTIVE_AUTO_EXECUTE=false
DEEPSIGNAL_INACTIVE_START=20:00
DEEPSIGNAL_INACTIVE_END=09:00
DEEPSIGNAL_INACTIVE_TIMEZONE=Asia/Seoul


# ── Telegram 알림 / 승인 ─────────────────────────────────────
# ★ 실제 알림은 DEEPSIGNAL_NOTIFY_* 두 개만 읽습니다. (아래 TELEGRAM_* 는 설정폼용)
# 봇 토큰: BotFather(@BotFather)에서 /newbot 으로 발급
# Chat ID: 봇과 대화 시작 후 https://api.telegram.org/bot<토큰>/getUpdates 의 chat.id
DEEPSIGNAL_NOTIFY_TELEGRAM_BOT_TOKEN=
DEEPSIGNAL_NOTIFY_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=             # (웹 설정폼 표시용 — 알림은 위 NOTIFY_ 가 우선)
TELEGRAM_CHAT_ID=


# ── 웹 UI (선택) ─────────────────────────────────────────────
# 외부 접속용 cloudflare 터널 공개 URL (자동 갱신됨, 비워둬도 됨)
DEEPSIGNAL_WEBUI_PUBLIC_URL=


# ── ML / 고급 전략 (기본값 권장, 잘 알 때만 변경) ────────────
CRYPTO_GATE_MODE=ml_primary             # 코인 ML 매수 게이트 모드
CRYPTO_ML_BUY_GATE=true
CRYPTO_EXECUTION_ENGINE=true            # 코인 정밀 체결 엔진
CRYPTO_FASTLANE_ENABLED=false           # 고확신 신호 즉시 체결
CRYPTO_PYRAMIDING_ENABLED=false         # 수익 포지션 추가매수
CRYPTO_FEEDBACK_TUNING_ENABLED=false    # 체결결과로 문턱 자동튜닝
KR_SCANNER_ADAPTIVE=false               # 국내 급등주 진입밴드 매일 자동학습


# ── 기타 (선택) ──────────────────────────────────────────────
# DB_PATH=
# NOTIFY_ON_FAILURE=false
# WEBHOOK_URL=
# MARKET_SYMBOLS=AAPL,NVDA,MSFT,GOOGL,AMZN,META
